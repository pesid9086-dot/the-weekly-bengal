{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/article/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*facebookexternalhit.*|.*Facebot.*|.*Twitterbot.*|.*LinkedInBot.*|.*WhatsApp.*)"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
